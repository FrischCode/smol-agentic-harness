# SAH machine config — copy this to .env and fill in for this box.
#
# .env is gitignored; this file (.env.example) is the committed shape. The tool reads .env at
# startup and fills only the variables it does not already have in the environment, so a value
# you export in the shell (or pass on the command line) always wins over the file.
#
# The values shown are the shipped fallbacks — a conventional LLM port on loopback, a local
# SearXNG. Change them to this machine's real endpoints.

# --- backend: the OpenAI-compatible server the run talks to -------------------
# Shipped fallback is 127.0.0.1:8080 (a conventional LLM endpoint port). Set this box's real
# host and port.
SAH_HOST=127.0.0.1
SAH_PORT=8080
# Model name to request. Empty = the server's default model.
#SAH_MODEL=
# A full base URL when the server is not http://HOST:PORT/v1 (a gateway path, or https). When set
# it owns the scheme, and SAH_HOST / SAH_PORT are ignored.
#SAH_BASE_URL=
# The API key, when the server wants one (sent as `Authorization: Bearer <key>`).
#SAH_API_KEY=
# The backend's context window in tokens. Unset: the run probes the backend for the number it
# declares (its model listing, then llama.cpp's /props), and a backend that declares none runs
# on the 32768 default with a notice — functional but likely degraded until you name the real
# value. The compaction arithmetic runs on this number, so a wrong one is a wrong trigger and a
# wrong room.
#SAH_CONTEXT=
# The reasoning level for a run that names no --think: sent verbatim, in the backend's own vocabulary
# (xhigh/medium/low on the Qwen3.8 family — its template 400s the OpenAI spelling `high` — and
# low/medium/high on OpenAI's). Unset or `on` sends no level at all: the server's own default.
# This file feeds runs the core launches (python -m sah); the sah/sah-call shims read SAH_THINK from
# the shell, so export it there to change the door's default.
SAH_THINK=xhigh

# --- search: only used when the run is started with --web ---------------------
# A SearXNG base URL; the search path /search?q=%s&format=json is built from it. Or set
# SAH_SEARCH_URL to a full search URL (e.g. a DuckDuckGo HTML endpoint) and leave this unset.
SEARXNG_BASE_URL=http://127.0.0.1:8888
#SAH_SEARCH_URL=

# --- the extension door -------------------------------------------------------
# The extension file a run loads when the invocation names none on --extension (the flag wins).
# Comma-separated for several; relative to the launch cwd. Naming it here is the same act as typing
# the flag, persisted in the machine's own config. The shipped occupants live in extensions/.
#SAH_EXTENSION=extensions/mcp_client.py

# --- mcp: only used when a run loads the extensions/mcp_client.py extension ---
# Stdio MCP servers the client launches at boot: semicolon-separated servers, each a
# comma-separated argv — the command that starts a stdio server, nothing else. Its advertised tools
# join the run's table at boot, declared self: the operator names the server, the model chooses the
# arguments, never the destination. A server that will not answer the handshake is a named refusal
# at boot, not a half-run.
#SAH_MCP_STDIO=
# Streamable HTTP MCP servers the same client loads: semicolon-separated full URLs (http:// or
# https://). The endpoint and its headers are the operator's act, fixed at boot; a 3xx is refused,
# not followed — a redirect off the named endpoint is not a destination the run chooses. A server
# may answer a request as a JSON body or an SSE stream; the client tells them apart by the body,
# not the Content-Type (a server in the wild is measured omitting it).
#SAH_MCP_HTTP=
# Extra request headers sent on every request to every named HTTP server, semicolon-separated
# `Name: Value` pairs — the operator's door to Bearer tokens and API keys.
#SAH_MCP_HTTP_HEADERS=Authorization: Bearer <token>
# Seconds a tools/call may take before the wrapper answers with the timeout (default 120), for a
# server on either wire.
#SAH_MCP_TIMEOUT=120

# --- speak: only used when a run loads the extensions/speak.py extension -------
# An OpenAI-compatible TTS endpoint the extension POSTs /v1/audio/speech to. The endpoint is the
# operator's act, fixed at boot: the model in a run chooses the words, never the place they go.
#SAH_SPEAK_HOST=127.0.0.1
#SAH_SPEAK_PORT=8000
# The model name the endpoint wants in the request (its /v1/models listing names it), and the voice
# to ask for (its /v1/audio/voices listing names what it serves).
#SAH_SPEAK_MODEL=tts
#SAH_SPEAK_VOICE=default
# Where the wav files land (default: the run's working directory). Seconds to wait for the endpoint
# (default 300: synthesis runs about real time); it is the playback's ceiling too.
#SAH_SPEAK_OUT=
#SAH_SPEAK_TIMEOUT=300
# 1/0: play the audio the tool writes, through the player binary named here (default 1 and ffplay).
# Mute a box whose runs would talk over each other.
#SAH_SPEAK_PLAY=1
#SAH_SPEAK_PLAYER=ffplay
# 1/0: announce the ask on the console's transient line the moment the model calls speak (default 1).
# Silence it for a box whose run flow already carries the ask in its own tool box.
#SAH_SPEAK_ANNOUNCE=1

# --- optional -----------------------------------------------------------------
# Who the run says it is (default: the OS user).
#SAH_USER=
# Where run folders live (default: ./runs under the working directory).
#SAH_RUNS=
# The shell the run's bash tool uses (default: Git Bash, else cmd.exe).
#SAH_SHELL=
# Read the .env from here instead of the tree root.
#SAH_ENV_FILE=
